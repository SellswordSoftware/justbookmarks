{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "maxNodeModuleJsDepth": 0,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "target": "es2022"
  },
  "include": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "wailsjs/**/*.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "wailsjs/**/*.js"
  ]
}
